{
  "name": "shared-chrome-mcp",
  "version": "0.1.0",
  "description": "One always-on, logged-in Chrome shared by any number of AI agents: a window per agent, a readiness wait after every action, an MCP server and a Claude Code plugin.",
  "keywords": ["mcp", "playwright", "chrome", "browser", "agents", "claude-code", "codex"],
  "license": "MIT",
  "author": "Zucchini (https://zucchini.chat)",
  "repository": "github:zucchini-chat/shared-chrome-mcp",
  "type": "module",
  "bin": {
    "shared-chrome-mcp": "cli.js"
  },
  "files": ["cli.js", "lib/"],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "smoke": "node test/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.83"
  },
  "overrides": {
    "playwright-core": "npm:rebrowser-playwright-core@1.64.101"
  }
}
